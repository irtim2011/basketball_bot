# Token from @BotFather
BOT_TOKEN=123456:AAAA-your-token-here

# Numeric Telegram user IDs of trainers, comma-separated.
# Get your own id from @userinfobot
TRAINER_IDS=111111111,222222222

# Path to the sqlite file (created automatically)
DB_PATH=training_bot.db

# How many minutes before training the poll goes out
POLL_OFFSET_MINUTES=180

# IANA timezone for scheduling
TIMEZONE=Europe/Moscow

# Bot-owned tab in Google Sheets. The JSON key is stored outside the project.
GOOGLE_SHEET_ID=1YNdUTiRQZ5q_NFu8dlNGDqTbSV3nmwZseq4ZIwy2s_g
GOOGLE_SHEET_NAME=Посещения_bot
GOOGLE_CREDENTIALS_FILE=~/.config/training-bot/google-service-account.json
